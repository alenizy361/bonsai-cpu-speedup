+                        codes[i] = _mm256_and_si256(_mm256_srlv_epi64(_mm256_set1_epi64x(xq), shifts), mask3);
+                    }
+                    for (int j = 0; j < RN; ++j) {
+                        const __m256i qyp = _mm256_load_si256((const __m256i *) (bp[j] + lo + 32 * s));
