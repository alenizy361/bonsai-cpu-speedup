From 40e926557865c366738dc6d42a22bb024110f648 Mon Sep 17 00:00:00 2001
From: abdulaziz <alanziabdulaziz4@gmail.com>
Date: Sat, 19 Sep 2026 01:59:31 +0300
Subject: [PATCH 02/15] gdn: take the in-place path in MTP speculative mode too
 (K = n_rs_seq + 1)

Drop the cparams.n_rs_seq == 0 restriction of the qwen35 gate: with
--spec-type draft-mtp the cache-writing op now updates slot 0 in place on
the live row and writes slots 1..min(T, K)-1 straight into the snapshot
planes of the same cell (rows_out = the existing s_write_rows mapping
slot*mem_size + head + seq); a pending rollback reads plane rs_idx of the
same cell (rows_in != rows_out -> copy-then-in-place in the kernel). No
dst state planes, no SET_ROWS, no per-thread state scratch. Transition
ubatches still take the gathered K-slot path.

GGML_GDN_INPLACE_K1_ONLY=1 restores the previous commit's K == 1 gate so
the two can be bisected on the same binary; GGML_GDN_STATE_GATHER=1 still
forces the legacy gathered path for everything.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QrdPnP5KL449GsoWBZx52R
---
 src/models/qwen35.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 89ab318..073a6e9 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -495,9 +495,15 @@ ggml_tensor * llama_model_qwen35::graph::build_layer_attn_linear(
     // only with the fused_gdn_* probes on), so the A/B stays bit-identical
     const bool fused_ok = cparams.n_rs_seq > 0 || (n_seq_tokens == 1 ? cparams.fused_gdn_ar : cparams.fused_gdn_ch);
 
-    // Stage 7A gate: in-place only without speculation (K == 1)
+    // GGML_GDN_INPLACE_K1_ONLY=1 restricts the in-place path to K == 1 (no
+    // speculation); by default the MTP speculative mode (K = n_rs_seq + 1) takes
+    // it too: slot 0 is updated in place, slots 1..K-1 are written straight into
+    // the snapshot planes of the same cell, and a pending rollback reads plane
+    // rs_idx of the same cell (rows_in != rows_out: copy-then-in-place).
+    static const bool gdn_inplace_k1_only_env = getenv("GGML_GDN_INPLACE_K1_ONLY") != nullptr;
+
     const bool gdn_state_inplace    = gdn_state_rows_env && gdn_state_inplace_dev_ok && inp->rs_inplace && fused_ok &&
-                                      cparams.n_rs_seq == 0;
+                                      (cparams.n_rs_seq == 0 || !gdn_inplace_k1_only_env);
     const bool gdn_state_rows_metal = gdn_state_rows_env && gdn_state_rows_dev_ok && !gdn_state_inplace_dev_ok &&
                                       cparams.n_rs_seq > 0;
     const bool gdn_state_rows       = gdn_state_inplace || gdn_state_rows_metal;
